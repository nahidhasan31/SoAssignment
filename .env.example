# Copy to .env before `docker compose up`. These are development values only: in
# staging and production every one of them is a Kubernetes secret produced by the
# External Secrets Operator from Azure Key Vault, and the application never sees a
# file containing any of them.

# --- runtime -----------------------------------------------------------------
ENVIRONMENT=local                     # local | staging | production
SERVICE_VERSION=2.1.0

# --- broker ------------------------------------------------------------------
BROKER_HOST=rabbitmq                  # Azure Service Bus in staging and production
BROKER_USER=maltashop
BROKER_PASSWORD=maltashop_dev_pw

# --- databases, one per service ----------------------------------------------
# Connection strings are composed in docker-compose.yml so that each service can
# only reach its own database; nothing shares a schema.

# --- behaviour ---------------------------------------------------------------
CARD_CEILING_EUR=1000                 # the stubbed provider declines above this
